{
  "name": "@recipes/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./src/rpc.ts"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development WEB_ORIGIN=http://localhost:5173 tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/lambda/index.js",
    "package:lambda": "pnpm build:lambda && cd dist/lambda && zip -qr ../api-lambda.zip index.js",
    "test": "vitest run --exclude 'dist/**'",
    "test:unit": "vitest run --exclude 'dist/**'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@hono/zod-validator": "0.9.1",
    "@recipes/core": "workspace:*",
    "@recipes/db": "workspace:*",
    "hono": "4.13.1",
    "jose": "6.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "^0.28.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
