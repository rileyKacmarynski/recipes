{
  "name": "@recipes/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./src/rpc.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/lambda/index.mjs",
    "package:lambda": "pnpm build:lambda && cd dist/lambda && zip -qr ../api-lambda.zip index.mjs",
    "test": "vitest run --exclude dist/**",
    "test:unit": "vitest run --exclude dist/**",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "latest",
    "@recipes/core": "workspace:*",
    "hono": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "esbuild": "^0.28.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
